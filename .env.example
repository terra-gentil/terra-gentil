# Chave do Gemini para o Doutor das Plantas (server-side, /api/diagnose).
# Gerar em https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Liga a rota /jogo (iframe do terra-gentil-game). Enquanto vazio ou !== "true",
# /jogo mostra a tela "Em breve". Setar pra "true" quando G10 estiver pronto.
NEXT_PUBLIC_GAME_ENABLED=

# Google Analytics 4 ID (formato G-XXXXXXXXXX). Se vazio, GA nao carrega.
# Pegar em https://analytics.google.com -> Administrador -> Streams de dados -> ID de medicao
NEXT_PUBLIC_GA_ID=

# Codigo de verificacao do Google Search Console (so o valor do content=, sem aspas).
# Pegar em https://search.google.com/search-console -> Adicionar propriedade -> tag HTML
NEXT_PUBLIC_GOOGLE_VERIFICATION=

# Resend - newsletter signup. Sem essas duas, /api/newsletter retorna 503 e o
# form mostra "Newsletter indisponível". Como configurar:
# 1) https://resend.com -> criar conta (free 3k/mes)
# 2) API Keys -> Create API Key (full access ou write em Contacts). Copiar pra RESEND_API_KEY.
# 3) Audience -> abrir o segmento (Resend migrou de "audiences" pra "segments").
#    O ID aparece na URL: resend.com/audience?segmentId=<UUID>. Copiar pra RESEND_SEGMENT_ID.
# 4) Verificar dominio em Domains (TXT na Hostinger) antes de mandar broadcast.
RESEND_API_KEY=
RESEND_SEGMENT_ID=

# Instagram Graph API - long-lived user access token (60 dias, refresh manual).
# Sem ele, /instagram e a secao Instagram da home usam placeholders coloridos.
# Como gerar:
# 1) Conta @canalterragentil precisa estar como "Profissional" (Criador ou Empresa)
# 2) developers.facebook.com -> Meus Apps -> Criar App -> tipo "Business"
# 3) Adicionar produto "Instagram"
# 4) Configurar OAuth: Login do Instagram com URI https://terragentil.com.br/auth (qualquer)
# 5) Permissoes: instagram_business_basic
# 6) Gerar short-lived token via flow OAuth, depois trocar por long-lived em
#    GET https://graph.instagram.com/access_token?grant_type=ig_exchange_token&client_secret=...&access_token=SHORT
# 7) Refresh antes de 60 dias em
#    GET https://graph.instagram.com/refresh_access_token?grant_type=ig_refresh_token&access_token=LONG
INSTAGRAM_ACCESS_TOKEN=
