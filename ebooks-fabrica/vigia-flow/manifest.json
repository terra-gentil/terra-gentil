{
  "manifest_version": 3,
  "name": "TG Vigia das Fotos",
  "version": "1.2",
  "description": "Le o estado da ferramenta Fotos Ebook TG (Flow) e roda o laco de 2K da galeria em ritmo humano, falando so com o receptor local 127.0.0.1:47812. Para ao primeiro aviso de limite ou atividade incomum.",
  "host_permissions": [
    "https://*.scf.usercontent.goog/*",
    "https://flow.google.com/*",
    "http://127.0.0.1:47812/*"
  ],
  "background": {
    "service_worker": "fundo.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.scf.usercontent.goog/*"],
      "js": ["ritmo.js", "conteudo.js"],
      "all_frames": true,
      "run_at": "document_idle",
      "match_origin_as_fallback": true,
      "match_about_blank": true
    },
    {
      "matches": ["https://flow.google.com/*"],
      "js": ["ritmo.js", "laco2k.js", "conteudo-galeria.js"],
      "all_frames": false,
      "run_at": "document_idle"
    }
  ]
}
