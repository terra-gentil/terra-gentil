{
  "manifest_version": 3,
  "name": "TG Vigia das Fotos",
  "version": "1.1",
  "description": "Le o estado da ferramenta Fotos Ebook TG (Flow) e o progresso do laco de 2K da galeria e entrega ao receptor local 127.0.0.1:47812. Nao clica, nao altera a pagina.",
  "host_permissions": [
    "https://*.scf.usercontent.goog/*",
    "https://flow.google.com/*",
    "http://127.0.0.1:47812/*"
  ],
  "background": {
    "service_worker": "fundo.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.scf.usercontent.goog/*"],
      "js": ["conteudo.js"],
      "all_frames": true,
      "run_at": "document_idle",
      "match_origin_as_fallback": true,
      "match_about_blank": true
    },
    {
      "matches": ["https://flow.google.com/*"],
      "js": ["conteudo-galeria.js"],
      "all_frames": false,
      "run_at": "document_idle"
    }
  ]
}
