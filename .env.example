# Chave do Gemini para o Doutor das Plantas (server-side, /api/diagnose).
# Gerar em https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Liga a rota /jogo (iframe do terra-gentil-game). Enquanto vazio ou !== "true",
# /jogo mostra a tela "Em breve". Setar pra "true" quando G10 estiver pronto.
NEXT_PUBLIC_GAME_ENABLED=

# Google Analytics 4 ID (formato G-XXXXXXXXXX). Se vazio, GA nao carrega.
# Pegar em https://analytics.google.com -> Administrador -> Streams de dados -> ID de medicao
NEXT_PUBLIC_GA_ID=

# Codigo de verificacao do Google Search Console (so o valor do content=, sem aspas).
# Pegar em https://search.google.com/search-console -> Adicionar propriedade -> tag HTML
NEXT_PUBLIC_GOOGLE_VERIFICATION=
